---
import { ViewTransitions } from 'astro:transitions';
import '../styles/global.css';
import { IDIOMA_BASE, TEXTOS, t } from '../i18n';

interface Props {
  /** título ya traducido: { en, es }. Si falta, se usa el del sitio */
  title?: { en: string; es: string };
  description?: { en: string; es: string };
  /** el header/footer del sitio; la ficha de librería va a pantalla completa sin ellos */
  chrome?: boolean;
}

const {
  title = TEXTOS['sitio.titulo'],
  description = TEXTOS['sitio.descripcion'],
  chrome = true,
} = Astro.props;

const anio = new Date().getFullYear();
const L = IDIOMA_BASE;

/* Las tarjetas que arman Google, WhatsApp, X y compañía se leen sin ejecutar
   JS, así que van en IDIOMA_BASE —el idioma con el que se sirve el HTML— y no
   en el que elija después quien visite. Las tres URL tienen que ser absolutas:
   una ruta relativa en og:image la ignoran casi todos. `site` sale de
   astro.config.mjs. La imagen la genera scripts/captura-og.mjs */
const canonica = new URL(Astro.url.pathname, Astro.site);
const imagenSocial = new URL('/og.jpg', Astro.site);
---

<!doctype html>
<html lang={L}>
  <head>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/* en línea y en el <head>: corre antes del primer pintado. Marca que hay
        JS para que la hoja pueda esconder lo que necesita medirse antes de
        verse (el encuadre del carrusel). Sin JS la clase no llega y no se
        esconde nada.

        Y de paso deja puesto el interruptor de animaciones del pie antes de
        que se pinte nada: si se esperara al bundle, quien lo apagó vería
        arrancar justo lo que apagó. La clave va escrita a mano porque un
        script en línea no puede importar: es CLAVE_MOTION de src/i18n.ts */}
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        if (localStorage.getItem('vivifyux:motion') === 'off') {
          document.documentElement.classList.add('sin-motion');
        }
      } catch (e) {}
    </script>
    {/* los dos idiomas viajan en el propio <title>: el script cambia document.title sin pedir nada al servidor */}
    <title data-titulo-en={title.en} data-titulo-es={title.es}>{title[L]}</title>
    <meta name="description" content={description[L]} data-i18n-attr="content" data-en={description.en} data-es={description.es} />
    <link rel="canonical" href={canonica.href} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="VivifyUX" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="es_ES" />
    <meta property="og:url" content={canonica.href} />
    <meta property="og:title" content={title[L]} />
    <meta property="og:description" content={description[L]} />
    <meta property="og:image" content={imagenSocial.href} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={TEXTOS['og.alt'][L]} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title[L]} />
    <meta name="twitter:description" content={description[L]} />
    <meta name="twitter:image" content={imagenSocial.href} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ViewTransitions />
  </head>
  <body>
    {/* efecto de tendencia a la meta: cuánto falta para el final */}
    <div class="progress" aria-hidden="true"><span></span></div>

    {
      chrome && (
        <header class="site-header">
          <a class="brand meta" href="/">
            VIVIFYUX
          </a>

          <div class="header-right meta">
            <p class="header-claim meta" data-i18n="header.claim">
              {t('header.claim', L)}
            </p>

            {/* el idioma se elige, no se rota: los dos siempre a la vista */}
            <div class="lang" role="group" aria-label="Idioma / Language">
              <button class="lang__op" type="button" data-idioma-opcion="en">
                EN
              </button>
              <button class="lang__op" type="button" data-idioma-opcion="es">
                ES
              </button>
            </div>
          </div>
        </header>
      )
    }

    <main>
      <slot />
    </main>

    {
      chrome && (
        <div class="footer-reveal">
          <footer class="site-footer">
            {/* firma: la marca a un lado, la promesa al otro, cerrando el ancho */}
            <div class="site-footer__sign">
              <a
                class="site-footer__mark display"
                href="/"
                data-i18n="footer.inicio"
                data-i18n-attr="aria-label"
                aria-label={t('footer.inicio', L)}>
                {'VIVIFYUX'.split('').map((letra) => (
                  <span aria-hidden="true">{letra}</span>
                ))}
              </a>
              <p class="site-footer__claim meta" data-i18n="footer.claim">
                {t('footer.claim', L)}
              </p>
            </div>

            <div class="site-footer__bar meta">
              <span>© {anio} VivifyUX</span>
              {/* el rótulo del arranque asume las animaciones encendidas; si
                  estaban apagadas, setupMotionToggle lo corrige al montar */}
              <button
                class="site-footer__motion"
                type="button"
                data-motion-toggle
                data-i18n="motion.apagar"
                aria-pressed="false">
                {t('motion.apagar', L)}
              </button>
              <a class="site-footer__top" href="#catalogo">
                <span data-i18n="footer.arriba">{t('footer.arriba', L)}</span>{' '}
                <span aria-hidden="true">↑</span>
              </a>
            </div>
          </footer>
        </div>
      )
    }

    <script>
      import { initSite } from '../scripts/site';
      import { iniciarIdioma, alCambiarIdioma } from '../scripts/idioma';

      // el idioma va primero: el riel del hero mide el ancho de cada palabra al
      // montarse, y si lo hace sobre el texto equivocado el bucle queda torcido
      document.addEventListener('astro:page-load', () => {
        iniciarIdioma();
        initSite();
      });

      // cambiar de idioma cambia el ancho de todo lo que está medido (el riel,
      // el título del filtro): se vuelve a montar en vez de parchear cada cosa
      alCambiarIdioma(() => initSite());
    </script>
  </body>
</html>
