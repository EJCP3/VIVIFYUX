---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { CATEGORIAS, IDIOMA_BASE, altCaptura, type Categoria } from '../i18n';

interface Props {
  slug: string;
  nombre: string;
  categoria: Categoria;
  imagen: ImageMetadata;
  video?: string;
  isCopy?: boolean;
}

const { slug, nombre, categoria, imagen, video, isCopy = false } = Astro.props;
const L = IDIOMA_BASE;
const etiqueta = CATEGORIAS[categoria];
---

<a
  class="tile"
  href={`/libreria/${slug}/`}
  data-vt={`cover-${slug}`}
  data-copy={isCopy ? "true" : undefined}
  data-hover-trigger={video ? true : undefined}>
  {/* mismo mecanismo que la ficha: la miniatura de abajo nunca se toca, esto
      es un video aparte, `position:fixed`, que hover-preview.ts posiciona en
      el cursor y muestra mientras el mouse está sobre esta tarjeta. Va
      adentro del <a> solo para que el propio JS lo encuentre por cercanía
      (`tile.querySelector`) — la tarjeta no tiene ningún transform que le
      cambie el containing block, así que el fixed sigue siendo relativo a la
      ventana igual */}
  {video && (
    <video
      class="hover-video"
      data-hover-video
      data-src={video}
      muted
      loop
      playsinline
      preload="none"
      disablepictureinpicture
      aria-hidden="true"
    />
  )}
  <div class="tile__media">
    <!-- espejo de --tile-w en global.css: la tarjeta se maqueta al tamaño del
         zoom final, así que el `sizes` es el real y no hay que inflarlo.
         Calidad alta: son capturas de interfaz con texto chico, lo primero que
         se ensucia al comprimir -->
    <Image
      src={imagen}
      alt={altCaptura(nombre, L)}
      widths={[600, 900, 1400, 1800]}
      sizes="(max-width: 900px) 92vw, 58vw"
      quality={88}
      data-i18n-attr="alt"
      data-en={altCaptura(nombre, 'en')}
      data-es={altCaptura(nombre, 'es')}
    />
  </div>
  <div class="tile__meta">
    <span class="tile__name">{nombre}</span>
    {/* el slug de la categoría vive en data-categoria y no en el texto: el
        filtro empareja por ahí, así la etiqueta puede traducirse sin romperlo */}
    <span
      class="tile__cat"
      data-categoria={categoria}
      data-en={`../${etiqueta.en}`}
      data-es={`../${etiqueta.es}`}>../{etiqueta[L]}</span>
  </div>
</a>
