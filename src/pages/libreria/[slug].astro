---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { CATEGORIAS, IDIOMA_BASE, altCaptura, t } from '../../i18n';

export async function getStaticPaths() {
  const libs = (await getCollection('librerias')).sort((a, b) => a.data.orden - b.data.orden);

  return libs.map((lib, i) => ({
    params: { slug: lib.slug },
    props: {
      lib,
      anterior: libs[(i - 1 + libs.length) % libs.length],
      siguiente: libs[(i + 1) % libs.length],
    },
  }));
}

const { lib, anterior, siguiente } = Astro.props;
const { nombre, claim, descripcion, url, npm, categoria, imagen } = lib.data;

/* claim y descripcion vienen del frontmatter como { en, es }: el HTML se pinta
   en el idioma base y el script cambia al otro con los data-en/data-es */
const L = IDIOMA_BASE;
const etiqueta = CATEGORIAS[categoria];
---

<Base
  title={{ en: `${nombre} — VivifyUX`, es: `${nombre} — VivifyUX` }}
  description={claim}
  chrome={false}>
  <article class="project">
    <div class="project__media">
      {/* la imagen va recortada a pantalla completa (object-fit: cover) sobre una
          caja casi cuadrada, y las capturas son apaisadas 1.9:1 — el navegador
          la estira hasta ~1.9 veces el alto del hueco. Por eso `sizes` declara
          el ancho REAL al que se pinta (mayor que el de la columna) y no el de
          la caja: con 55vw bajaba la variante de 1200 y se veía pixelada */}
      <Image
        src={imagen}
        alt={altCaptura(nombre, L)}
        widths={[900, 1400, 1860]}
        sizes="(max-width: 900px) 190vw, 105vw"
        quality={90}
        transition:name={`cover-${lib.slug}`}
        data-i18n-attr="alt"
        data-en={altCaptura(nombre, 'en')}
        data-es={altCaptura(nombre, 'es')}
      />
    </div>

    <div class="project__panel">
      <a
        class="project__close"
        href="/"
        data-i18n="ficha.cerrar"
        data-i18n-attr="aria-label"
        aria-label={t('ficha.cerrar', L)}
        data-cuelume-press="release">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M1 1l14 14M15 1L1 15" stroke="currentColor" stroke-width="1.6"></path>
        </svg>
      </a>

      <h1 class="project__title">{nombre}</h1>

      <p class="project__claim" data-en={claim.en} data-es={claim.es}>{claim[L]}</p>
      <p class="project__desc" data-en={descripcion.en} data-es={descripcion.es}>
        {descripcion[L]}
      </p>

      <div>
        <p class="meta" style="opacity:0.55;margin-bottom:12px;" data-i18n="ficha.categoria">
          {t('ficha.categoria', L)}
        </p>
        <div class="chips">
          <span class="chip" data-en={etiqueta.en} data-es={etiqueta.es}>{etiqueta[L]}</span>
        </div>
      </div>

      <div class="project__rule"></div>

      <div style="display:flex;flex-wrap:wrap;align-items:center;gap:16px;">
        <a class="project__cta meta" href={url} target="_blank" rel="noopener">
          <svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M6 2H2v12h12v-4M10 2h4v4M14 2L7 9" stroke="currentColor" stroke-width="1.6"></path>
          </svg>
          <span data-i18n="ficha.visitar">{t('ficha.visitar', L)}</span>
        </a>
        {npm && <code class="meta" style="opacity:0.6;">NPM I {npm.toUpperCase()}</code>}
      </div>

      <div class="project__rule"></div>

      <nav class="project__nav">
        <a class="side" href={`/libreria/${anterior.slug}/`} data-cuelume-press="loading">
          <span class="meta" style="opacity:0.55;" data-i18n="ficha.anterior">
            {t('ficha.anterior', L)}
          </span>
          <span class="name">← {anterior.data.nombre}</span>
        </a>
        <a class="side next" href={`/libreria/${siguiente.slug}/`} data-cuelume-press="loading">
          <span class="meta" style="opacity:0.55;" data-i18n="ficha.siguiente">
            {t('ficha.siguiente', L)}
          </span>
          <span class="name">{siguiente.data.nombre} →</span>
        </a>
      </nav>
    </div>
  </article>
</Base>
