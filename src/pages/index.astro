---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Tile from "../components/Tile.astro";
import FilterIsland from "../components/FilterIsland.astro";


const libs = (await getCollection("librerias")).sort(
  (a, b) => a.data.orden - b.data.orden,
);

/* --- la grilla: 2 filas, cada una con el catálogo entero rotado,
   repetido 3 veces para que la marquesina cierre el bucle sin saltos.
   Son 2 y no más porque el encuadre final enmarca exactamente dos: las
   siguientes nunca se veían enteras, solo asomaban por el borde --- */
const FILAS = 2;
const COPIAS = 3;

/* --- el título gigante rota entre la marca, palabras sueltas y frases cortas.
   El JS le baja el tamaño a cada una para que entre en el ancho de pantalla,
   así que una frase larga se ve más chica que una palabra. La marca vuelve
   cada seis entradas: funciona como estribillo. Separador "|" porque algunas
   frases llevan coma --- */
const PALABRAS = [
  "VIVIFYUX",
  "INTERACCIÓN",
  "FLUIDEZ",
  "ANIMACIÓN",
  "VIVIFYUX",
  "EXPERIENCIA",
  "CREATIVIDAD",
  "DINAMISMO",
  "VIVIFYUX",
  "MOTION",
  "DISEÑO",
  "IMPACTO",
  "INTERACTIVOS",
  "VISUAL",
  "ANIMACIÓN",
  "VIVIFYUX",
  "VIBRANTE"

];

/* --- leyes de lawsofux.com/es, cada una atada a algo que este sitio hace --- */


const filas = Array.from({ length: FILAS }, (_, i) => {
  const corte = (i * 3) % libs.length;
  const rotado = [...libs.slice(corte), ...libs.slice(0, corte)];
  return Array.from({ length: COPIAS }, () => rotado).flat();
});

/* --- datos reales derivados del catálogo --- */
const categorias = [
  "scroll",
  "texto",
  "transiciones",
  "efectos",
  "sonido",
  "motor",
] as const;
const porCategoria = categorias.map((c) => ({
  nombre: c,
  total: libs.filter((l) => l.data.categoria === c).length,
}));
---

<Base>
  <!-- ===== filtro de categorías (Dynamic Island) ===== -->
  <FilterIsland categorias={porCategoria} total={libs.length} />

  <!-- ===== capítulo de trabajos: el zoom-out de la grilla ===== -->
  <section class="works" id="catalogo">
    <div class="works__stage">
      <div class="works__scaler">
        
        <!-- ===== HERO MARQUEE (INCAMANA STYLE) ===== -->
        <div class="scrolling-text">
          <div class="rail">
            {['VIVIFYUX', ...PALABRAS, 'VIVIFYUX', ...PALABRAS].map((palabra) => (
              <h4 data-text={palabra.toUpperCase()} data-cuelume-press="tick">
                <div class="flair">
                  <svg class="flair-star" viewBox="0 0 100 100">
                    <g fill="currentColor">
                      <rect x="42" y="0" width="16" height="100" rx="8" />
                      <rect x="0" y="42" width="100" height="16" rx="8" />
                      <rect x="42" y="0" width="16" height="100" rx="8" transform="rotate(45 50 50)" />
                      <rect x="42" y="0" width="16" height="100" rx="8" transform="rotate(-45 50 50)" />
                    </g>
                  </svg>
                  <svg class="flair-circle" viewBox="0 0 100 100">
                    <circle cx="50" cy="50" r="35" stroke="currentColor" stroke-width="20" fill="none" />
                  </svg>
                </div>
                {palabra.toUpperCase().split('').map((letra) => (
                  <span>{letra}</span>
                ))}
              </h4>
            ))}
          </div>
        </div>

        <div class="rows">
          {
            filas.map((fila) => (
              <div class="row">
                <div class="row__track" data-copies={COPIAS}>
                  {fila.map((lib, idx) => (
                    <Tile
                      slug={lib.slug}
                      nombre={lib.data.nombre}
                      categoria={lib.data.categoria}
                      imagen={lib.data.imagen}
                      isCopy={idx >= libs.length}
                    />
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>


 

  <!-- ===== técnicas / categorías ===== -->
  <section class="section">
    <div class="section__inner">
      <h2 class="display section__title" data-reveal>Técnicas</h2>
      <div>
        <ul class="list" data-reveal data-reveal-children>
          {
            porCategoria.map((c) => (
              <li class="list__row meta">
                <span>{c.nombre}</span>
                <span class="num">x{c.total}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>



  <!-- ===== contacto: cierra el contenido, justo encima del pie ===== -->
  <section class="contact">
    <h2 class="display contact__display">¿Falta<br />alguna?</h2>
    <div class="contact__aside">
      <p class="copy contact__copy">
        El catálogo crece con lo que propone quien lo usa. Si conoces una
        librería que merece estar acá, cuéntala en un issue y la revisamos.
      </p>
      <a
        class="pill meta"
        href="https://github.com/vivifyux/vivifyux.github.io/issues/new"
        target="_blank"
        rel="noopener">Proponer una librería ↗</a>
    </div>
  </section>
</Base>
